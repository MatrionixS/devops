//describe all vpcs
aws ec2 describe-vpcs
//describe all security groups or group by id parameter
aws ec2 describe-security-groups (optional --group-ids someId)
//add firewall for security group
aws ec2 authorize-security-group-ingress \
--group-id someId
--protocol tcp\
--port 22 \
--cidr someIpAddress
//create empty security group
aws ec2 create-security-group \
--group-name my-sh \
--description "My Sg" \
--vpi-id someId
//create key pair and save to local file
aws ec2 create-key-pair \
--key-name MyKpCli \
--query 'KeyMaterial' \
--output text > MyKpCli.pem
//describe all subnets
aws ec2 describe-subnets
//describe all images
aws ec2 describe-images
//create ec2 instance
aws ec2 run-instances \
--image-id ami-someId
--count 1 \
--instance-type t2.micro \
--key-name MyKpCli \
--security-group-ids sg-someId \
--subnet-id subnet-someId
//describe all instances
aws ec2 describe-instances
